# 이 파일을 복사해서 이름을 .env 로 바꾸고 값을 채우세요 (Vercel은 Settings → Environment Variables)
# 공통 저장소 — 컨설팅 수정표(wonju_checks, wonju_comments)와 기본계획·현안 코멘트(comments)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# (선택) 예전 3장 사이트가 다른 Supabase 프로젝트를 썼다면 그 값을 여기에 — 기존 3장 코멘트를 그대로 이어서 씀
# VITE_PLAN_SUPABASE_URL=https://yyyyyyyyyyyy.supabase.co
# VITE_PLAN_SUPABASE_KEY=sb_publishable_yyyyyyyyyyyyyyyy
